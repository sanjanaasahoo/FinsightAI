# ---------------------------------------------------------------------
# FinSight AI Backend — Environment Configuration Template
# ---------------------------------------------------------------------
# Copy this file to `.env` in the same directory and fill in real values
# for local development. Never commit the real `.env` file.

# =======================================================================
# REQUIRED for the current build (upload, analytics, scenarios, ML risk,
# and — if you want AI insights — Gemini)
# =======================================================================

# General
APP_NAME=FinSight AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite only — no PostgreSQL)
DATABASE_URL=sqlite:///./finsight.db

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Gemini — powers POST /api/insights/summary and POST /api/insights/ask.
# Leave GEMINI_API_KEY blank to run WITHOUT AI insights: every other
# endpoint (upload, analytics, scenarios, ML risk) works fully without
# it. With it blank, the two /api/insights/* endpoints return a clean
# HTTP 503 ("AI insights not configured...") instead of an error.
# Get a key at https://aistudio.google.com/apikey — never commit a real
# key, and never put it in frontend code (it is read server-side only,
# via this environment variable).
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Note: there is no ML-specific environment variable. The trained model
# lives at a fixed path (app/ml/risk_model.joblib) and is produced by
# running `python3 -m app.ml.train_model` — see the README's "ML Risk
# Module" section.

# =======================================================================
# NOT required for the current build — reserved for later phases
# (present so the environment is complete and stable if/when those
# phases are built; nothing in the current code reads these except the
# unused-but-harmless defaults below)
# =======================================================================

# Auth — no authentication system exists in this build yet.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_SUPER_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG / document Q&A — NOT being built; no PDF/embedding/FAISS code
# exists in this repository yet.
DOCUMENT_STORAGE_DIR=./storage/documents
FAISS_INDEX_DIR=./storage/faiss_indexes
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MAX_DOCUMENT_SIZE_MB=20
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
