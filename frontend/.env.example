# ---------------------------------------------------------------------
# FinSight AI Frontend — Environment Configuration Template
# ---------------------------------------------------------------------
# Copy this file to `.env` for local development.
#
# Vite only exposes variables prefixed with VITE_ to client-side code.
#
# In development this can usually be left blank — the Vite dev-server
# proxy (see vite.config.js) forwards /api requests to the local backend.
# In production (Vercel), set this to the deployed Render backend URL,
# e.g. https://finsight-ai-backend.onrender.com
VITE_API_BASE_URL=
